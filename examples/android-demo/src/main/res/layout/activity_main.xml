<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true" android:clipToPadding="false">
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/eyebrow" android:textSize="12sp" android:letterSpacing="0.1"
            android:textColor="@color/link_blue" android:textStyle="bold" />
        <TextView style="@style/DemoTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="@string/title" android:textSize="30sp" />
        <TextView style="@style/DemoBody"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/subtitle" />
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp"
            android:layout_marginTop="24dp" android:background="@drawable/card">
            <TextView android:id="@+id/status" style="@style/DemoTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:accessibilityLiveRegion="polite" />
            <TextView android:id="@+id/message" style="@style/DemoBody"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="10dp" android:accessibilityLiveRegion="polite" />
            <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent" android:layout_height="4dp"
                android:layout_marginTop="16dp" android:indeterminate="true" />
            <Button android:id="@+id/sign_in" style="@style/DemoPrimaryButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/sign_in" />
            <Button android:id="@+id/cancel_sign_in" style="@style/DemoButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/cancel_sign_in" android:visibility="gone" />
            <Button android:id="@+id/sign_out" style="@style/DemoButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/sign_out" android:visibility="gone" />
        </LinearLayout>
        <LinearLayout android:id="@+id/profile_card"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp" android:visibility="gone"
            android:layout_marginTop="16dp" android:background="@drawable/card">
            <TextView android:id="@+id/profile_initial"
                android:layout_width="56dp" android:layout_height="56dp"
                android:background="@drawable/avatar" android:gravity="center"
                android:textSize="24sp" android:textColor="@color/link_blue"
                android:importantForAccessibility="no" />
            <TextView android:id="@+id/profile_name" style="@style/DemoTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" />
            <TextView android:id="@+id/profile_username" style="@style/DemoBody"
                android:layout_width="match_parent" android:layout_height="wrap_content" />
            <TextView android:id="@+id/profile_details" style="@style/DemoBody"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textIsSelectable="true" />
            <Button android:id="@+id/check_session" style="@style/DemoButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/check_session" />
            <Button android:id="@+id/refresh_session" style="@style/DemoButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/refresh_session" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="20dp"
            android:layout_marginTop="16dp" android:background="@drawable/card">
            <TextView style="@style/DemoTitle"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/configuration" />
            <TextView android:id="@+id/config_details" style="@style/DemoBody"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:textIsSelectable="true" />
            <TextView android:id="@+id/callback" style="@style/DemoBody"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:fontFamily="monospace"
                android:textSize="12sp" android:textIsSelectable="true" />
            <Button android:id="@+id/import_config" style="@style/DemoButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/import_config" />
            <Button android:id="@+id/paste_config" style="@style/DemoButton"
                android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/paste_config" />
        </LinearLayout>
        <TextView style="@style/DemoTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="28dp" android:text="@string/events" />
        <TextView style="@style/DemoBody"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="@string/event_hint" />
        <TextView android:id="@+id/event_log" style="@style/DemoBody"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:fontFamily="monospace" android:textSize="12sp"
            android:paddingBottom="24dp" />
    </LinearLayout>
</ScrollView>
